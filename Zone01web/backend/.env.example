# Zone01 API environment configuration.
# Copy to .env and adjust for your machine.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zone01
# Seconds to persist database connections (0 closes after each request).
DB_CONN_MAX_AGE=60

# Reported by the health endpoint.
APP_VERSION=dev

# CORS: which frontend origins may call the JSON API (/api/).
# Comma-separated full origins, local or hosted. Example:
#   API_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://zone01-kisumu.org
API_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Quick local escape hatch: allow every origin (do NOT use in production).
API_CORS_ALLOW_ALL=false
