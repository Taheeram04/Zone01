# Zone01 API environment configuration.
# Copy to .env and adjust for your machine.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: include the public domain(s) the site is served from, e.g.
#   DJANGO_ALLOWED_HOSTS=www.zone01kisumu.ke,zone01kisumu.ke,localhost,127.0.0.1

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zone01
# Seconds to persist database connections (0 closes after each request).
DB_CONN_MAX_AGE=60

# Reported by the health endpoint.
APP_VERSION=dev

# CORS: which frontend origins may call the JSON API (/api/).
# Comma-separated full origins, local or hosted. When the frontend is served
# from the same domain as the API, list that domain too. Production example:
#   API_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://www.zone01kisumu.ke,https://zone01kisumu.ke
API_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Quick local escape hatch: allow every origin (do NOT use in production).
API_CORS_ALLOW_ALL=false

# Full origins trusted for CSRF (admin login) when served over HTTPS, e.g.
#   CSRF_TRUSTED_ORIGINS=https://zone01-kisumu-api.fly.dev
CSRF_TRUSTED_ORIGINS=

# Uploaded media storage. Leave BUCKET_NAME empty to store files in media/.
# On Fly.io, `fly storage create` sets these as secrets for a Tigris bucket.
BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev

# Public URL of the React frontend. The admin "Frontend status" page links to
# it and checks it, plus every active row under "Frontend pages".
FRONTEND_URL=http://localhost:5173
# Seconds to wait for each frontend check before reporting it unreachable.
FRONTEND_HEALTH_TIMEOUT=5
