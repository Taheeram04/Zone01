# Base URL of the Django CMS backend API.
#
# Development: leave empty to use the Vite dev/preview proxy (see
# vite.config.js), which forwards /api to http://127.0.0.1:8000.
#
# Production: set this at build time to the backend origin if the frontend is
# hosted on a different domain, e.g.
#   VITE_API_BASE_URL=https://api.zone01.example
# and add the frontend origin to the backend's API_CORS_ALLOWED_ORIGINS.
# If Django serves the built frontend from the same origin, leave it empty.
VITE_API_BASE_URL=
